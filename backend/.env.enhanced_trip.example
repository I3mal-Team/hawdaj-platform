ENHANCED_TRIP_MAX_CONCURRENT=5
ENHANCED_TRIP_TIMEOUT=60

# إعدادات التجريب والتطوير
ENHANCED_TRIP_DEBUG=false
ENHANCED_TRIP_DEBUG_SQL=false
ENHANCED_TRIP_MOCK_GOOGLE=false
