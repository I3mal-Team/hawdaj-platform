# Enhanced Trip System Environment Variables
# نسخ هذه المتغيرات إلى ملف .env الرئيسي

# تفعيل النظام المحسن
ENHANCED_TRIP_ENABLED=true

# إعدادات الأماكن
ENHANCED_TRIP_MAX_PLACES_PER_DAY=20
ENHANCED_TRIP_MIN_PLACES_PER_DAY=2
ENHANCED_TRIP_SEARCH_RADIUS=50
ENHANCED_TRIP_MAX_TOTAL_PLACES=200

# إعدادات Google Maps
GOOGLE_MAPS_API_KEY=AIzaSyDDSTB8emANyFuYPdfvIGCq_3e0ZZ6lKJc
GOOGLE_MAPS_TIMEOUT=30
GOOGLE_MAPS_MAX_WAYPOINTS=25

# إعدادات التخزين المؤقت
ENHANCED_TRIP_CACHE_ENABLED=true
ENHANCED_TRIP_CACHE_TTL=3600

# إعدادات التسجيل
ENHANCED_TRIP_LOGGING_ENABLED=true
ENHANCED_TRIP_LOG_LEVEL=info
ENHANCED_TRIP_LOG_CHANNEL=daily

# إعدادات التحقق من صحة البيانات
ENHANCED_TRIP_MAX_DURATION=30
ENHANCED_TRIP_MIN_DURATION=1
ENHANCED_TRIP_MAX_CATEGORIES=10
ENHANCED_TRIP_MAX_PRICE_RANGES=5

# إعدادات الأداء
